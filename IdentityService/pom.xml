<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>


	<!--
	 This Parent Spring boot starter is very important , where there is no need to specifying any
	 version to spring boot dependencies , where based on the spring boot version, it will find
	 the best suitable dependencies, like we have spring-boot-starter-actutator , spring-boot-starter-data-jpa
	 , spring-boot-starter-Security etc. For all these packages based on the spring boot version we
	 specified it will get's the best suitable version. and also configures default compiler settings
	 (Java 21), encoding rules.
	 -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.ThoughtsAndOpinions</groupId>
	<artifactId>IdentityService</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Use the latest Protobuf and gRPC Java versions -->
		<protobuf.version>4.29.3</protobuf.version>
		<grpc.version>1.70.0</grpc.version>
		<!-- These groupIds are NOT managed by the Spring Boot BOM, so we pin
		     them here as properties and reference them below. -->
		<spring-grpc.version>1.0.3</spring-grpc.version>
		<jjwt.version>0.13.0</jjwt.version>
		<minio.version>8.5.17</minio.version>
	</properties>
	<dependencies>
		<!--
		Actuator dependency provides us production ready health monitoring , application metrics,
		checking end points whether server was running or not.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
		 The Spring boot Starter Security gives some security tools like password hashing,
		 cryptographic tools and many more

		 When Come to data JPA , it gives us the ability to build database schemas in Java
		 Classes via JPA rules and provides underlying hibernate orm.

		 When Comes to Postgres SQL Driver, That helps to Communicate with the Postgres Database
		 seamlessly , as postgres sql follows postgres protocol, so it helps in connecting with
		 postgres database.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
			Lombok Autogenerates the Setters, getters and Constructors for a class.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- The official modern Spring package used to host high-performance gRPC services.
		It automatically manages your server setup on start and handles functional global
		exception routing out of the box.
		-->
		<dependency>
			<groupId>org.springframework.grpc</groupId>
			<artifactId>spring-grpc-server-spring-boot-starter</artifactId>
			<version>${spring-grpc.version}</version>
		</dependency>

		<!-- 2. Spring Data JPA for your Identity DB Layer -->
		<!-- (already declared above; removed the duplicate that was here) -->

		<!-- JJWT: not managed by the Spring Boot BOM, all three modules need
		     an explicit version. jjwt-api was previously missing one, which
		     is what made resolution fail. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- MinIO client: also not managed by the Spring Boot BOM, needs an
		     explicit version (previously missing entirely). -->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>${minio.version}</version>
		</dependency>

		<!-- 4. Required for Java 9+ to compile Protobuf classes correctly -->
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- The plugin that automatically converts your .proto files into Java classes -->
			<plugin>
				<groupId>io.github.ascopes</groupId>
				<artifactId>protobuf-maven-plugin</artifactId>
				<version>5.1.8</version>

				<configuration>
					<protoc kind="binary-maven">
						<version>${protobuf.version}</version>
					</protoc>

					<plugins>
						<plugin kind="binary-maven">
							<groupId>io.grpc</groupId>
							<artifactId>protoc-gen-grpc-java</artifactId>
							<version>${grpc.version}</version>
						</plugin>
					</plugins>
				</configuration>

				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>